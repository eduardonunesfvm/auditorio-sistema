# Configuracao do Banco de Dados
# Desenvolvimento local (PostgreSQL local):
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/auditorio_db
# Producao (Railway): use uma referencia para DATABASE_URL do servico PostgreSQL

# Seguranca JWT
# ALTERE ESSA CHAVE EM PRODUCAO! Use uma string aleatoria forte.
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# Algoritmo de assinatura JWT
ALGORITHM=HS256

# Tempo de expiracao do token de acesso (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Redis privado do Railway (referencia para REDIS_URL do servico Redis)
REDIS_URL=redis://localhost:6379/0

# Rate limit de POST /auth/login
LOGIN_RATE_LIMIT_IP_MAX=10
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_LOGIN_MAX=5
LOGIN_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# OpenTelemetry / Grafana Cloud (desabilitado por padrao)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-REGIAO.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20CREDENCIAL_GERADA_PELO_GRAFANA
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=auditorio-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=auditorio,deployment.environment.name=development
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_SEMCONV_STABILITY_OPT_IN=http
