DATABASE_URL=postgresql://usuario:senha@host:5432/auditorio_db

SECRET_KEY=sua-chave-secreta-super-segura-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Apenas em ENV=staging. Gere valores reais no gerenciador de secrets.
STAGING_GATE_ENABLED=false
STAGING_GATE_PASSWORD_HASH=
STAGING_GATE_SECRET=

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-REGIAO.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20CREDENCIAL_GERADA_PELO_GRAFANA
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=auditorio-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=auditorio,deployment.environment.name=development
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_SEMCONV_STABILITY_OPT_IN=http
